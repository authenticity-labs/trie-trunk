+// Benchmark-only: prepare exactly the inputs consumed by each member SHA-256.
+// Validation and preparation run outside the timed raw-digest loop.
+pub fn prepared_hash_inputs(definitions: &[Definition]) -> Result<Vec<Vec<u8>>,String> {
+ let mut ds=definitions.to_vec();normalize(&mut ds)?;let hs=hashes(&ds)?;
+ ds.iter().map(|d|{let mut input=member_bytes(d,None,false)?;let mut refs=vec![];references(&d.fields,&mut refs)?;for r in refs{input.extend_from_slice(&hs[r]);}Ok(input)}).collect()
+}
