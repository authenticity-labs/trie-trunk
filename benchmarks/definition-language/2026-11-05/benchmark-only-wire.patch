+// Benchmark-only copy: preserve normalization and all semantic validation, omit digest preparation.
+fn validate_without_digest(definitions: &[Definition]) -> Result<(), String> {
+    let mut canonical = definitions.to_vec();
+    normalize(&mut canonical)?;
+    let definitions = canonical.as_slice();
+    if definitions.is_empty() || definitions.len() > 256 {
+        return Err("RX requires 1–256 definitions".into());
+    }
+    let mut identities = std::collections::HashSet::new();
+    for d in definitions {
+        if d.header.pil_version != 0 {
+            return Err("Unsupported definition language version".into());
+        }
+        if d.header.rx_name.is_empty()
+            || !identities.insert((
+                &d.header.namespace,
+                &d.header.rx_name,
+                d.header.rx_major,
+                d.header.rx_minor,
+            ))
+        {
+            return Err("Definition identities must be nonempty and unique within PAC".into());
+        }
+        language::validate(&d.fields, definitions.len())?;
+    }
+    fn visit(i: usize, ds: &[Definition], active: &mut [bool], done: &mut [bool]) -> Result<(), String> {
+        if done[i] { return Ok(()); }
+        if active[i] { return Err("Recursive definition reference".into()); }
+        active[i]=true;
+        let mut refs=vec![];
+        references(&ds[i].fields,&mut refs)?;
+        for r in refs { if r>=ds.len() { return Err("Object ordinal outside PAC".into()); } visit(r,ds,active,done)?; }
+        active[i]=false;done[i]=true;Ok(())
+    }
+    let mut active=vec![false;definitions.len()];let mut done=vec![false;definitions.len()];
+    for i in 0..definitions.len(){visit(i,definitions,&mut active,&mut done)?;}
+    Ok(())
+}
