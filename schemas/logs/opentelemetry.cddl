; Single-record provider profile. Additional keys remain valid.

log_opentelemetry = {
 ? "Timestamp": uint .size 8,
 ? "SeverityNumber": uint .size 8,
 ? "Body": any,
 ? "EventName": tstr,
 ? "TraceId": bstr .size 16,
 ? "SpanId": bstr .size 8,
 ? "TraceFlags": uint .size 8,
 ? "SeverityText": tstr,
 ? Attributes: {
  ? "error.type": tstr,
  ? "exception.message": tstr,
  ? "exception.stacktrace": tstr,
  * tstr => any
 },
 * tstr => any
}


