    "log-http_trietrunk": [
      {
        "name": "method",
        "semantic": "method",
        "label": "Method",
        "description": "HTTP request method, preserving its original spelling.",
        "source": "iana-method",
        "values": [
          {
            "value": "GET",
            "label": "GET",
            "description": "Retrieve a representation."
          },
          {
            "value": "HEAD",
            "label": "HEAD",
            "description": "Retrieve response headers without the representation body."
          },
          {
            "value": "POST",
            "label": "POST",
            "description": "Submit content for processing."
          },
          {
            "value": "PUT",
            "label": "PUT",
            "description": "Replace the target representation."
          },
          {
            "value": "PATCH",
            "label": "PATCH",
            "description": "Apply a partial modification."
          },
          {
            "value": "DELETE",
            "label": "DELETE",
            "description": "Remove the target resource."
          },
          {
            "value": "OPTIONS",
            "label": "OPTIONS",
            "description": "Describe available communication options."
          },
          {
            "value": "CONNECT",
            "label": "CONNECT",
            "description": "Establish a tunnel."
          },
          {
            "value": "TRACE",
            "label": "TRACE",
            "description": "Perform a diagnostic request loopback."
          }
        ]
      },
      {
        "name": "status",
        "semantic": "status",
        "label": "Status",
        "description": "HTTP response code, absent when no response exists.",
        "source": "iana-status",
        "values": [
          {
            "value": "100",
            "label": "Continue",
            "description": "The request body may follow."
          },
          {
            "value": "101",
            "label": "Switching Protocols",
            "description": "The connection is changing protocols."
          },
          {
            "value": "200",
            "label": "OK",
            "description": "The request succeeded."
          },
          {
            "value": "201",
            "label": "Created",
            "description": "A resource was created."
          },
          {
            "value": "202",
            "label": "Accepted",
            "description": "Processing was accepted but may not be complete."
          },
          {
            "value": "204",
            "label": "No Content",
            "description": "The request succeeded without a response body."
          },
          {
            "value": "206",
            "label": "Partial Content",
            "description": "The response contains the requested portion."
          },
          {
            "value": "301",
            "label": "Moved Permanently",
            "description": "The resource has a permanent replacement URI."
          },
          {
            "value": "302",
            "label": "Found",
            "description": "Use the supplied temporary location."
          },
          {
            "value": "304",
            "label": "Not Modified",
            "description": "The cached representation remains valid."
          },
          {
            "value": "307",
            "label": "Temporary Redirect",
            "description": "Repeat the request at the temporary location."
          },
          {
            "value": "308",
            "label": "Permanent Redirect",
            "description": "Repeat the request at the permanent location."
          },
          {
            "value": "400",
            "label": "Bad Request",
            "description": "The request could not be accepted as sent."
          },
          {
            "value": "401",
            "label": "Unauthorized",
            "description": "Authentication is required or was not accepted."
          },
          {
            "value": "403",
            "label": "Forbidden",
            "description": "The server refuses the requested access."
          },
          {
            "value": "404",
            "label": "Not Found",
            "description": "The requested resource was not found."
          },
          {
            "value": "405",
            "label": "Method Not Allowed",
            "description": "The resource does not support this method."
          },
          {
            "value": "408",
            "label": "Request Timeout",
            "description": "The request was not received in time."
          },
          {
            "value": "409",
            "label": "Conflict",
            "description": "The request conflicts with the current resource state."
          },
          {
            "value": "410",
            "label": "Gone",
            "description": "The resource is no longer available."
          },
          {
            "value": "412",
            "label": "Precondition Failed",
            "description": "A request condition was not satisfied."
          },
          {
            "value": "413",
            "label": "Content Too Large",
            "description": "The request content exceeds the accepted size."
          },
          {
            "value": "415",
            "label": "Unsupported Media Type",
            "description": "The request content format is unsupported."
          },
          {
            "value": "422",
            "label": "Unprocessable Content",
            "description": "The content could not be processed as instructed."
          },
          {
            "value": "429",
            "label": "Too Many Requests",
            "description": "The request rate exceeds an accepted limit."
          },
          {
            "value": "500",
            "label": "Internal Server Error",
            "description": "The server could not complete the request."
          },
          {
            "value": "502",
            "label": "Bad Gateway",
            "description": "An upstream response was invalid."
          },
          {
            "value": "503",
            "label": "Service Unavailable",
            "description": "The service cannot currently handle the request."
          },
          {
            "value": "504",
            "label": "Gateway Timeout",
            "description": "An upstream response did not arrive in time."
          }
        ]
      },
